@model IEnumerable<BloodBankManagement.ViewModels.BloodInventoryViewModel>
@{
    ViewData["Title"] = "Blood Inventory";
    Layout = "_Layout";
}

<div class="container mt-4 mb-5">
    <!-- Header Banner with Medical Laboratory Image -->
    <div class="page-header-banner d-flex justify-content-between align-items-center">
        <img src="~/images/medical_lab_bg.jpg" alt="Medical Laboratory Inventory Background" class="banner-bg-img" />
        <div class="position-relative" style="z-index: 1;">
            <h2 class="auth-title fw-bold text-white mb-1"><i class="fas fa-cubes me-2 text-danger"></i> Live Blood Inventory</h2>
            <p class="text-light opacity-90 small mb-0">Real-time blood stock levels and supply tracking across all blood groups</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <div class="position-relative" style="z-index: 1;">
                <button class="btn auth-btn rounded-pill px-4 shadow-lg" data-bs-toggle="modal" data-bs-target="#updateInventoryModal">
                    <i class="fas fa-plus-circle me-2"></i> Update Stock Level
                </button>
            </div>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show glass-panel text-white border-success border-opacity-50 mb-4" role="alert">
            <i class="fas fa-check-circle me-2 text-success"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Bar -->
    <div class="glass-panel p-3 rounded-4 mb-4">
        <div class="row g-2 align-items-center">
            <div class="col-md-8">
                <div class="position-relative">
                    <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-light opacity-50"></i>
                    <input type="text" id="stockSearchInput" class="form-control auth-input ps-5" placeholder="Search blood group (e.g. A+, O-)..." />
                </div>
            </div>
            <div class="col-md-4 text-end">
                <span class="badge bg-dark border border-secondary text-light px-3 py-2 rounded-pill fs-6">
                    <i class="fas fa-layer-group me-1 text-danger"></i> Total Groups: @Model.Count()
                </span>
            </div>
        </div>
    </div>

    <div class="row g-4" id="inventoryGrid">
        @foreach (var item in Model)
        {
            <div class="col-xl-3 col-lg-4 col-sm-6 inventory-card-item" data-group="@item.BloodGroup">
                <div class="glass-panel glass-panel-hover p-4 rounded-4 text-center h-100 position-relative overflow-hidden" style="border-top: 4px solid @(item.Units < 5 ? "#ef4444" : item.Units < 10 ? "#f59e0b" : "#10b981");">
                    
                    @if (item.Units < 5)
                    {
                        <div class="position-absolute top-0 end-0 p-3" title="Critical Low Stock!">
                            <span class="badge bg-danger rounded-pill px-2 py-1 small animate-pulse">
                                <i class="fas fa-exclamation-triangle me-1"></i> LOW
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="position-absolute top-0 end-0 p-3">
                            <span class="status-dot status-dot-active" title="Stock Available"></span>
                        </div>
                    }

                    <div class="mb-3">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-2" style="width: 75px; height: 75px; background: rgba(239, 68, 68, 0.15); border: 2px solid rgba(239, 68, 68, 0.3);">
                            <span class="h1 fw-bold text-white mb-0">@item.BloodGroup</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center align-items-baseline gap-2 mb-2">
                        <h2 class="fw-bold mb-0 @(item.Units < 5 ? "text-danger" : item.Units < 10 ? "text-warning" : "text-success")">@item.Units</h2>
                        <span class="text-light opacity-75 fw-semibold">Units</span>
                    </div>

                    <div class="progress rounded-pill mb-3" style="height: 8px; background: rgba(15, 23, 42, 0.8);">
                        <div class="progress-bar rounded-pill @(item.Units < 5 ? "bg-danger" : item.Units < 10 ? "bg-warning" : "bg-success")" 
                             role="progressbar" 
                             style="width: @(Math.Min(item.Units * 5, 100))%"></div>
                    </div>

                    <div class="small text-light opacity-75">
                        <i class="fas fa-clock me-1 text-info"></i> Updated @item.LastUpdated.ToString("MMM dd, HH:mm")
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5 glass-panel rounded-4">
                <i class="fas fa-box-open fa-3x text-light opacity-50 mb-3"></i>
                <h4 class="text-white fw-bold">No Inventory Data</h4>
                <p class="text-light opacity-75">Inventory records have not been initialized yet.</p>
            </div>
        }
    </div>
</div>

<!-- Update Inventory Modal -->
<div class="modal fade" id="updateInventoryModal" tabindex="-1" aria-labelledby="updateInventoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-panel border-0 text-white p-2">
            <div class="modal-header border-bottom border-secondary border-opacity-25">
                <h5 class="modal-title fw-bold" id="updateInventoryModalLabel"><i class="fas fa-pen-to-square text-danger me-2"></i> Update Blood Stock</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateInventory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="bloodGroup" class="form-label">Blood Group</label>
                        <select class="form-select auth-input" id="bloodGroup" name="bloodGroup" required>
                            <option value="">Select Group...</option>
                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B-">B-</option>
                            <option value="AB+">AB+</option>
                            <option value="AB-">AB-</option>
                            <option value="O+">O+</option>
                            <option value="O-">O-</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="units" class="form-label">Units to Add / Remove (Use negative value to reduce)</label>
                        <input type="number" class="form-control auth-input" id="units" name="units" placeholder="e.g. 5 or -2" required>
                    </div>
                </div>
                <div class="modal-footer border-top border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn auth-btn rounded-pill px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('stockSearchInput')?.addEventListener('keyup', function () {
            const query = this.value.toUpperCase().trim();
            const cards = document.querySelectorAll('.inventory-card-item');
            cards.forEach(card => {
                const group = card.getAttribute('data-group') || '';
                if (group.toUpperCase().includes(query)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    </script>
}
