@model IEnumerable<BloodBankManagement.ViewModels.AppointmentViewModel>
@{
    ViewData["Title"] = "Donation Appointments";
    Layout = "_Layout";
}

<div class="container mt-4 mb-5">
    <!-- Header Banner with Medical Background Graphic -->
    <div class="page-header-banner d-flex justify-content-between align-items-center">
        <img src="~/images/appointment_bg.jpg" alt="Emergency Appointments Background" class="banner-bg-img" />
        <div class="position-relative" style="z-index: 1;">
            <h2 class="auth-title fw-bold text-white mb-1"><i class="fas fa-calendar-alt me-2 text-danger"></i> Donation Appointments</h2>
            <p class="text-light opacity-90 small mb-0">Track and manage blood donation appointments with unique Donor IDs</p>
        </div>
        @if (User.IsInRole("Donor") || User.IsInRole("Admin"))
        {
            <div class="position-relative" style="z-index: 1;">
                <a asp-action="Create" class="btn auth-btn rounded-pill px-4 shadow-lg">
                    <i class="fas fa-calendar-plus me-2"></i> Book Appointment
                </a>
            </div>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show glass-panel text-white border-success border-opacity-50 mb-4" role="alert">
            <i class="fas fa-check-circle me-2 text-success"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="glass-panel rounded-4 overflow-hidden p-3">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="border-bottom border-secondary border-opacity-25" style="background: rgba(15, 23, 42, 0.8);">
                    <tr>
                        <th class="py-3 px-3">Donor Information</th>
                        <th class="py-3 px-3">Blood Group</th>
                        <th class="py-3 px-3">Date & Time</th>
                        <th class="py-3 px-3">Notes</th>
                        <th class="py-3 px-3">Status</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="py-3 px-3 text-end">Admin Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appointment in Model)
                    {
                        <tr class="border-bottom border-secondary border-opacity-25">
                            <td class="py-3 px-3">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-danger bg-opacity-20 p-2 me-3 text-danger border border-danger border-opacity-25">
                                        <i class="fas fa-user-circle fa-lg"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-white fs-6">
                                            @appointment.DonorName
                                            <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-40 px-2 py-0.5 rounded-pill ms-2" style="font-size: 0.75rem;" title="Unique Donor ID">
                                                <i class="fas fa-id-card me-1"></i> Donor ID: #@appointment.DonorId
                                            </span>
                                        </div>
                                        <span class="small text-light opacity-75">
                                            Appt Ref: <strong class="text-info">#AP-@appointment.Id</strong>
                                        </span>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3 px-3">
                                <span class="badge bg-danger px-3 py-1.5 fs-6 rounded-pill">
                                    <i class="fas fa-droplet me-1"></i> @(appointment.DonorBloodType ?? "Unspecified")
                                </span>
                            </td>
                            <td class="py-3 px-3 text-light">
                                <i class="far fa-clock me-1 text-info"></i> @appointment.AppointmentDate.ToString("MMM dd, yyyy HH:mm")
                            </td>
                            <td class="py-3 px-3 text-light opacity-75 small">
                                @(string.IsNullOrWhiteSpace(appointment.Notes) ? "-" : appointment.Notes)
                            </td>
                            <td class="py-3 px-3">
                                @if (appointment.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="fas fa-hourglass-half me-1"></i> Pending</span>
                                }
                                else if (appointment.Status == "Approved")
                                {
                                    <span class="badge bg-info text-dark px-3 py-2 rounded-pill"><i class="fas fa-thumbs-up me-1"></i> Approved</span>
                                }
                                else if (appointment.Status == "Rejected")
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="fas fa-times-circle me-1"></i> Rejected</span>
                                }
                                else if (appointment.Status == "Completed")
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill"><i class="fas fa-check-circle me-1"></i> Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2 rounded-pill">@appointment.Status</span>
                                }
                            </td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="py-3 px-3 text-end">
                                    <div class="d-inline-flex gap-1">
                                        @if (appointment.Status == "Pending")
                                        {
                                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@appointment.Id" />
                                                <input type="hidden" name="newStatus" value="Approved" />
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3" title="Approve Appointment">
                                                    <i class="fas fa-check me-1"></i> Approve
                                                </button>
                                            </form>
                                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@appointment.Id" />
                                                <input type="hidden" name="newStatus" value="Rejected" />
                                                <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3" title="Reject Appointment">
                                                    <i class="fas fa-times me-1"></i> Reject
                                                </button>
                                            </form>
                                        }
                                        else if (appointment.Status == "Approved")
                                        {
                                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@appointment.Id" />
                                                <input type="hidden" name="newStatus" value="Completed" />
                                                <button type="submit" class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3 shadow-sm" title="Mark Completed & Add to Inventory">
                                                    <i class="fas fa-syringe me-1"></i> Mark Completed
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-light opacity-50 small">No actions</span>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="@(User.IsInRole("Admin") ? 6 : 5)" class="text-center py-5">
                                <i class="fas fa-calendar-times fa-3x text-light opacity-50 mb-3 d-block"></i>
                                <span class="text-light opacity-75">No appointments found.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
