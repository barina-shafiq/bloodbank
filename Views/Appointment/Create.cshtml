@model BloodBankManagement.ViewModels.AppointmentViewModel
@{
    ViewData["Title"] = "Book Donation Appointment";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="glass-panel rounded-4 p-4 p-md-5 position-relative overflow-hidden" style="border-top: 4px solid #ef4444;">
                <div class="text-center mb-4">
                    <h2 class="auth-title fw-bold text-white"><i class="fas fa-calendar-check me-2 text-danger"></i> Book Donation Appointment</h2>
                    <p class="text-muted">Select a date and time to donate blood and help save lives</p>
                </div>

                @if (ViewBag.IntervalWarning != null)
                {
                    <div class="alert alert-warning border-warning border-opacity-50 mb-4 rounded-3">
                        <i class="fas fa-exclamation-triangle me-2 text-warning"></i> @ViewBag.IntervalWarning
                    </div>
                }

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="mb-3">
                            <label asp-for="DonorId" class="form-label text-muted small fw-bold">DONOR ID (GUID)</label>
                            <input asp-for="DonorId" class="form-control auth-input" placeholder="Enter Donor GUID" required />
                            <span asp-validation-for="DonorId" class="text-danger small"></span>
                        </div>
                    }

                    <div class="mb-4">
                        <label asp-for="AppointmentDate" class="form-label text-muted small fw-bold">PREFERRED DATE & TIME</label>
                        <input asp-for="AppointmentDate" class="form-control auth-input" type="datetime-local" required />
                        <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                        <span class="form-text text-muted" style="font-size: 0.8rem;">Select a date and time in the future.</span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label text-muted small fw-bold">ADDITIONAL NOTES / MEDICAL COMMENTS (OPTIONAL)</label>
                        <textarea asp-for="Notes" class="form-control auth-input" rows="3" placeholder="Any special notes, preferred location, or health remarks..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4 border-top border-secondary border-opacity-25 pt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">Cancel</a>
                        <button type="submit" class="btn auth-btn px-5 rounded-pill fw-bold">Book Appointment <i class="fas fa-check ms-2"></i></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

