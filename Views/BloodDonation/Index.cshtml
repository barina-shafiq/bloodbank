@model IEnumerable<BloodBankManagement.ViewModels.BloodDonationViewModel>
@{
    ViewData["Title"] = "Blood Donations";
    Layout = "_Layout";
}

@using BloodBankManagement.Models

<div class="container mt-4 mb-5">
    <!-- Header Banner with Authentic Phlebotomy Photo -->
    <div class="page-header-banner d-flex justify-content-between align-items-center">
        <img src="~/images/blood_donation_bg.jpg" alt="Blood Donation Log Background" class="banner-bg-img" />
        <div class="position-relative" style="z-index: 1;">
            <h2 class="auth-title fw-bold text-white mb-1"><i class="fas fa-syringe me-2 text-success"></i> Blood Donations Log</h2>
            <p class="text-light opacity-90 small mb-0">Track verified blood donations and record successful donor contributions</p>
        </div>
        @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Donor))
        {
            <div class="position-relative" style="z-index: 1;">
                <a asp-action="Create" class="btn auth-btn rounded-pill px-4 shadow-lg">
                    <i class="fas fa-plus me-2"></i> Log Donation
                </a>
            </div>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show glass-panel text-white border-success border-opacity-50" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="glass-panel rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-dark table-hover table-borderless mb-0 align-middle">
                <thead class="border-bottom border-secondary border-opacity-25" style="background: rgba(0,0,0,0.2);">
                    <tr>
                        <th class="py-3 px-4 text-muted fw-normal">Donor ID</th>
                        <th class="py-3 px-4 text-muted fw-normal">Date</th>
                        <th class="py-3 px-4 text-muted fw-normal">Blood Group</th>
                        <th class="py-3 px-4 text-muted fw-normal">Units Donated</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var donations = Model ?? Enumerable.Empty<BloodBankManagement.ViewModels.BloodDonationViewModel>(); }
                    @foreach (var donation in donations)
                    {
                        <tr class="border-bottom border-secondary border-opacity-10">
                            <td class="py-3 px-4 text-white">@donation.DonorId</td>
                            <td class="py-3 px-4 text-light">@donation.DonationDate.ToString("MMM dd, yyyy")</td>
                            <td class="py-3 px-4">
                                <span class="badge bg-danger rounded-pill px-3 py-2 fw-bold">@donation.BloodGroup</span>
                            </td>
                            <td class="py-3 px-4 fw-bold text-success">+@donation.UnitsDonated</td>
                        </tr>
                    }
                    @if (!donations.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <i class="fas fa-history fa-3x text-muted mb-3 d-block"></i>
                                <span class="text-muted">No donations logged yet.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
