@model IEnumerable<BloodBankManagement.ViewModels.HospitalViewModel>
@{
    ViewData["Title"] = "Hospitals Directory";
    Layout = "_Layout";
}

<div class="container mt-4 mb-5">
    <!-- Header Banner with Authentic Hospital Professional Photo -->
    <div class="page-header-banner d-flex justify-content-between align-items-center">
        <img src="~/images/hospital_care.jpg" alt="Partner Hospitals Background" class="banner-bg-img" />
        <div class="position-relative" style="z-index: 1;">
            <h2 class="auth-title fw-bold text-white mb-1"><i class="fas fa-hospital me-2 text-info"></i> Partner Hospitals</h2>
            <p class="text-light opacity-90 small mb-0">Verified medical institutions, blood donation centers, and partner healthcare facilities</p>
        </div>
        <div class="position-relative" style="z-index: 1;">
            <a asp-action="Create" class="btn auth-btn rounded-pill px-4 shadow-lg">
                <i class="fas fa-plus me-2"></i> Add Hospital
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show glass-panel text-white border-success border-opacity-50" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        @foreach (var hospital in Model)
        {
            <div class="col-md-4 col-sm-6">
                <div class="glass-panel p-4 rounded h-100 position-relative" style="border-top: 4px solid var(--secondary-color);">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h4 class="text-white mb-0 fw-bold">@hospital.Name</h4>
                        @if (hospital.IsActive)
                        {
                            <span class="badge bg-success rounded-pill"><i class="fas fa-check me-1"></i> Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary rounded-pill">Inactive</span>
                        }
                    </div>
                    <p class="text-muted small mb-3"><i class="fas fa-map-marker-alt me-2 text-info"></i> @hospital.Address</p>
                    <div class="mt-auto">
                        <div class="d-flex align-items-center text-light small mb-2">
                            <i class="fas fa-phone me-2 text-muted"></i> @hospital.ContactNumber
                        </div>
                        <div class="d-flex align-items-center text-light small">
                            <i class="fas fa-envelope me-2 text-muted"></i> @hospital.Email
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 text-end">
                        <a href="#" class="btn btn-sm btn-outline-info rounded-pill px-3">View Details <i class="fas fa-chevron-right ms-1"></i></a>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5 glass-panel rounded">
                <i class="fas fa-building fa-3x text-muted mb-3"></i>
                <h4 class="text-white">No Hospitals Found</h4>
                <p class="text-muted">There are currently no registered partner hospitals in the system.</p>
            </div>
        }
    </div>
</div>
