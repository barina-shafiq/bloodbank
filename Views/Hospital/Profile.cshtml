@model BloodBankManagement.ViewModels.HospitalViewModel
@{
    ViewData["Title"] = "Hospital Profile";
    Layout = "_Layout";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-light rounded-pill px-3">
                    <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
                </a>
                <span class="text-muted small">Account Type: <strong class="text-white">Hospital Partner</strong></span>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show glass-panel text-white border-success border-opacity-50 mb-4" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="glass-panel rounded-3 p-5 position-relative overflow-hidden" style="border-top: 4px solid #818cf8;">
                <div class="text-center mb-4">
                    <h2 class="auth-title"><i class="fas fa-hospital me-2 text-info"></i> Hospital Partner Profile</h2>
                    <p class="text-muted">Manage your hospital information and emergency contact details</p>
                </div>

                <form asp-controller="Hospital" asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">HOSPITAL NAME</label>
                        <input asp-for="Name" class="form-control auth-input" placeholder="e.g. City General Hospital" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label">HOSPITAL ADDRESS</label>
                        <input asp-for="Address" class="form-control auth-input" placeholder="e.g. 123 Health Ave, Metro City" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ContactNumber" class="form-label">CONTACT NUMBER</label>
                            <input asp-for="ContactNumber" class="form-control auth-input" placeholder="e.g. 555-0199" />
                            <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">REGISTERED EMAIL</label>
                            <input class="form-control auth-input" value="@Model.Email" readonly disabled />
                            <span class="text-info small mt-1 d-block"><i class="fas fa-info-circle me-1"></i> Email address cannot be changed.</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 border-top border-secondary border-opacity-25 pt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light px-4 rounded-pill">
                            <i class="fas fa-arrow-left me-2"></i> Back to Dashboard
                        </a>
                        <button type="submit" class="btn auth-btn px-5 rounded-pill" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);">
                            <i class="fas fa-check-circle me-2"></i> Save Profile
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
