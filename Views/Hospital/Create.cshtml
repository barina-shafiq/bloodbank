@model BloodBankManagement.ViewModels.HospitalViewModel
@{
    ViewData["Title"] = "Add Hospital";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="glass-panel rounded-3 p-5 position-relative overflow-hidden" style="border-top: 4px solid var(--secondary-color);">
                <div class="text-center mb-4">
                    <h2 class="auth-title"><i class="fas fa-hospital-user me-2 text-info"></i> Add Partner Hospital</h2>
                    <p class="text-muted">Register a new hospital to the network</p>
                </div>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label text-muted small fw-bold">HOSPITAL NAME</label>
                        <input asp-for="Name" class="form-control auth-input" placeholder="City General Hospital" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label text-muted small fw-bold">FULL ADDRESS</label>
                        <textarea asp-for="Address" class="form-control auth-input" rows="3" placeholder="123 Health Ave, Medical District"></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ContactNumber" class="form-label text-muted small fw-bold">CONTACT NUMBER</label>
                            <input asp-for="ContactNumber" class="form-control auth-input" placeholder="+1 234 567 8900" />
                            <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="Email" class="form-label text-muted small fw-bold">EMAIL ADDRESS</label>
                            <input asp-for="Email" class="form-control auth-input" placeholder="contact@hospital.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4 border-top border-secondary border-opacity-25 pt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">Cancel</a>
                        <button type="submit" class="btn auth-btn px-5 rounded-pill" style="background: linear-gradient(135deg, var(--secondary-color) 0%, #1e40af 100%); box-shadow: 0 10px 20px -10px var(--secondary-color);">
                            Register Hospital <i class="fas fa-check ms-2"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
