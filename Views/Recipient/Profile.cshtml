@model BloodBankManagement.ViewModels.RecipientViewModel
@{
    ViewData["Title"] = "Recipient Profile";
    Layout = "_Layout";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-light rounded-pill px-3">
                    <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
                </a>
                <span class="text-muted small">Account Type: <strong class="text-white">Recipient</strong></span>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show glass-panel text-white border-success border-opacity-50 mb-4" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="glass-panel rounded-3 p-5 position-relative overflow-hidden" style="border-top: 4px solid var(--secondary-color);">
                <div class="text-center mb-4">
                    <h2 class="auth-title"><i class="fas fa-user-injured me-2 text-warning"></i> Recipient Profile</h2>
                    <p class="text-muted">Manage your personal profile and blood request preferences</p>
                </div>

                <form asp-controller="Recipient" asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label">FIRST NAME</label>
                            <input asp-for="FirstName" class="form-control auth-input" placeholder="e.g. John" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label">LAST NAME</label>
                            <input asp-for="LastName" class="form-control auth-input" placeholder="e.g. Doe" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="BloodGroup" class="form-label">REQUIRED BLOOD GROUP</label>
                            <select asp-for="BloodGroup" class="form-select auth-input">
                                <option value="">Select Blood Group...</option>
                                <option value="A+">A+</option><option value="A-">A-</option>
                                <option value="B+">B+</option><option value="B-">B-</option>
                                <option value="AB+">AB+</option><option value="AB-">AB-</option>
                                <option value="O+">O+</option><option value="O-">O-</option>
                            </select>
                            <span asp-validation-for="BloodGroup" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ContactNumber" class="form-label">CONTACT NUMBER</label>
                            <input asp-for="ContactNumber" class="form-control auth-input" placeholder="e.g. 555-0199" />
                            <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">REGISTERED EMAIL</label>
                        <input class="form-control auth-input" value="@Model.Email" readonly disabled />
                        <span class="text-info small mt-1 d-block"><i class="fas fa-info-circle me-1"></i> Email address cannot be changed.</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 border-top border-secondary border-opacity-25 pt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light px-4 rounded-pill">
                            <i class="fas fa-arrow-left me-2"></i> Back to Dashboard
                        </a>
                        <button type="submit" class="btn auth-btn px-5 rounded-pill" style="background: linear-gradient(135deg, var(--secondary-color) 0%, #2563eb 100%);">
                            <i class="fas fa-check-circle me-2"></i> Save Profile
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
