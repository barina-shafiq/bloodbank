using BloodBankManagement.Models;
using BloodBankManagement.Services;
using BloodBankManagement.ViewModels;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Identity;
using Microsoft.AspNetCore.Mvc;
using Microsoft.Extensions.Logging;
using System;
using System.Linq;
using System.Threading.Tasks;

namespace BloodBankManagement.Controllers
{
    [Authorize]
    public class DonorController : Controller
    {
        private readonly IDonorService _donorService;
        private readonly ILogger<DonorController> _logger;
        private readonly UserManager<ApplicationUser> _userManager;

        public DonorController(IDonorService donorService, ILogger<DonorController> logger, UserManager<ApplicationUser> userManager)
        {
            _donorService = donorService;
            _logger = logger;
            _userManager = userManager;
        }

        [Authorize(Roles = Models.Roles.AdminAndHospital)]
        public async Task<IActionResult> Index()
        {
            try
            {
                // Admin and Hospital continue to see full donor list
                var donors = await _donorService.GetAllDonorsAsync() ?? Enumerable.Empty<Donor>();
                var viewModels = donors.Select(d => new DonorViewModel
                {
                    Id = d.Id,
                    FirstName = d.FirstName,
                    LastName = d.LastName,
                    BloodType = d.BloodType,
                    ContactNumber = d.ContactNumber,
                    Email = d.Email,
                    IsActive = d.IsActive
                }).ToList();
                return View(viewModels);
            }
            catch (Exception ex)
            {
                _logger?.LogError(ex, "Failed to load donors for dashboard.");
                return View(new List<DonorViewModel>());
            }
        }

        [Authorize(Roles = Models.Roles.Admin + "," + Models.Roles.Donor + "," + Models.Roles.Hospital)]
        public IActionResult Create()
        {
            return View();
        }

        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> Create(DonorViewModel model)
        {
            if (ModelState.IsValid)
            {
                var donor = new Donor
                {
                    FirstName = model.FirstName,
                    LastName = model.LastName,
                    BloodType = model.BloodType,
                    DateOfBirth = model.DateOfBirth,
                    ContactNumber = model.ContactNumber,
                    Email = model.Email,
                    IsActive = true
                };
                // If the current user is in Donor role, ensure donor.Email matches their account email
                if (User.Identity.IsAuthenticated)
                {
                    var currentUser = await _userManager.GetUserAsync(User);
                    if (currentUser != null && await _userManager.IsInRoleAsync(currentUser, Models.Roles.Donor))
                    {
                        donor.Email = currentUser.Email;
                    }
                }

                await _donorService.AddDonorAsync(donor);
                TempData["SuccessMessage"] = "Donor registered successfully.";
                return RedirectToAction(nameof(Index));
            }
            return View(model);
        }
    }
}
