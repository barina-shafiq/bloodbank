@model BloodBankManagement.ViewModels.BloodRequestViewModel
@{
    ViewData["Title"] = "New Blood Request";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="glass-panel rounded-3 p-5 position-relative overflow-hidden" style="border-top: 4px solid var(--primary-color);">
                <div class="text-center mb-4">
                    <h2 class="auth-title"><i class="fas fa-hand-holding-medical me-2 text-danger"></i> New Blood Request</h2>
                    <p class="text-muted">Submit a request for blood units needed at your facility</p>
                </div>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="HospitalId" class="form-label text-muted small fw-bold">HOSPITAL ID</label>
                            <input asp-for="HospitalId" class="form-control auth-input" placeholder="e.g., 1" required />
                            <span asp-validation-for="HospitalId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="BloodGroup" class="form-label text-muted small fw-bold">BLOOD GROUP NEEDED</label>
                            <select asp-for="BloodGroup" class="form-select bg-dark text-white border-secondary border-opacity-50" style="border-radius:12px; height: 58px;" required>
                                <option value="">Select Blood Type...</option>
                                <option value="A+">A+</option><option value="A-">A-</option>
                                <option value="B+">B+</option><option value="B-">B-</option>
                                <option value="AB+">AB+</option><option value="AB-">AB-</option>
                                <option value="O+">O+</option><option value="O-">O-</option>
                            </select>
                            <span asp-validation-for="BloodGroup" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="UnitsRequested" class="form-label text-muted small fw-bold">UNITS REQUESTED</label>
                        <input asp-for="UnitsRequested" class="form-control auth-input" type="number" min="1" max="100" required />
                        <span asp-validation-for="UnitsRequested" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4 border-top border-secondary border-opacity-25 pt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">Cancel</a>
                        <button type="submit" class="btn auth-btn px-5 rounded-pill">Submit Request <i class="fas fa-paper-plane ms-2"></i></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
