@model IEnumerable<BloodBankManagement.ViewModels.BloodRequestViewModel>
@{
    ViewData["Title"] = "Blood Requests";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="auth-title"><i class="fas fa-hand-holding-water me-2 text-warning"></i> Blood Requests</h2>
        @if (User.IsInRole("Hospital") || User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-outline-light rounded-pill px-4">
                <i class="fas fa-plus me-2"></i> New Request
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show glass-panel text-white border-success border-opacity-50" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="glass-panel rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-dark table-hover table-borderless mb-0 align-middle">
                <thead class="border-bottom border-secondary border-opacity-25" style="background: rgba(0,0,0,0.2);">
                    <tr>
                        <th class="py-3 px-4 text-muted fw-normal">Hospital ID</th>
                        <th class="py-3 px-4 text-muted fw-normal">Date</th>
                        <th class="py-3 px-4 text-muted fw-normal">Blood Group</th>
                        <th class="py-3 px-4 text-muted fw-normal">Units</th>
                        <th class="py-3 px-4 text-muted fw-normal">Status</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="py-3 px-4 text-muted fw-normal text-end">Action</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr class="border-bottom border-secondary border-opacity-10">
                            <td class="py-3 px-4 text-white">#@request.HospitalId</td>
                            <td class="py-3 px-4 text-light">@request.RequestDate.ToString("MMM dd, yyyy")</td>
                            <td class="py-3 px-4">
                                <span class="badge bg-danger rounded-pill px-3 py-2 fw-bold">@request.BloodGroup</span>
                            </td>
                            <td class="py-3 px-4 fw-bold">@request.UnitsRequested</td>
                            <td class="py-3 px-4">
                                @if (request.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill">Pending</span>
                                }
                                else if (request.Status == "Approved" || request.Status == "Fulfilled")
                                {
                                    <span class="badge bg-success px-3 py-1 rounded-pill">@request.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-1 rounded-pill">@request.Status</span>
                                }
                            </td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="py-3 px-4 text-end">
                                    @if (request.Status == "Pending")
                                    {
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@request.Id" />
                                            <input type="hidden" name="newStatus" value="Approved" />
                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">Approve</button>
                                        </form>
                                    }
                                </td>
                            }
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="fas fa-inbox fa-3x text-muted mb-3 d-block"></i>
                                <span class="text-muted">No blood requests found.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
