@model BloodBankManagement.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log in";
    Layout = "_Layout";
}

<div class="auth-wrapper d-flex align-items-center justify-content-center">
    <div class="auth-card glass-panel">
        <div class="text-center mb-4">
            <h2 class="auth-title">Welcome Back</h2>
            <p class="text-muted">Sign in to continue to your account</p>
        </div>

        <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" role="form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-floating mb-3">
                <input asp-for="Email" class="form-control auth-input" autocomplete="email" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Email" class="form-label"></label>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Password" class="form-control auth-input" autocomplete="current-password" aria-required="true" placeholder="password" />
                <label asp-for="Password" class="form-label"></label>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="checkbox mb-4 d-flex justify-content-between align-items-center">
                <label asp-for="RememberMe" class="form-label text-muted m-0">
                    <input class="form-check-input me-2" asp-for="RememberMe" />
                    @Html.DisplayNameFor(m => m.RememberMe)
                </label>
                <a href="#" class="forgot-link text-decoration-none">Forgot Password?</a>
            </div>

            <button id="login-submit" type="submit" class="w-100 btn btn-lg auth-btn">Log in <i class="fas fa-arrow-right ms-2"></i></button>

            <div class="mt-4 text-center">
                <p class="text-muted m-0">Don't have an account? <a asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]" class="register-link fw-bold text-decoration-none">Register here</a></p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
